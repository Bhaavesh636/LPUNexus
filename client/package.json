{
  "name": "lpunexus",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first academic copilot Chrome extension for LPU students",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:sidepanel": "vite build --config vite.config.ts",
    "build:background": "vite build --config vite.background.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "build": "npm run build:sidepanel && npm run build:background && npm run build:content",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.8"
  }
}
